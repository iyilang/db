# crystal-db's spec/db_spec.cr.
module db/db_test

import std/uri::{Params}
import db
import db/errors::*
import db/core::*
import db/query_params::{fetch_bool}
import db/spec::{describe, it, expect_error}
import db/testing/dummy_driver::*

def connections : Array(DummyConnection)
  DummyConnection.connections
end

describe "Db" do
  it "should get driver class by name" do
    assert ::Db.driver_class("dummy").or_panic == DummyDriver
  end

  it "should create dummy connection" do
    db = ::Db.open("dummy://localhost:1027").or_panic
    assert db.checkout.or_panic.is_a?(DummyConnection)
  end

  it "should create a connection and close it" do
    DummyConnection.clear_connections
    ::Db.open("dummy://localhost") do |db|
    end.or_panic
    assert connections.size == 1
    assert connections.first.closed?
  end

  it "should create a connection and close it" do
    DummyConnection.clear_connections
    ::Db.connect("dummy://localhost") do |cnn|
      assert cnn.is_a?(DummyConnection)
    end.or_panic
    assert connections.size == 1
    assert connections.first.closed?
  end

  it "should create a connection and wait for explicit closing" do
    DummyConnection.clear_connections
    cnn = ::Db.connect("dummy://localhost").or_panic
    assert cnn.is_a?(DummyConnection)
    assert connections.size == 1
    assert !connections.first.closed?
    cnn.close
    assert connections.first.closed?
  end

  it "query should close result_set" do
    with_witness do |w|
      with_dummy do |db|
        db.query("1,2") do
          break
        end

        w.check
        assert DummyResultSet.last_result_set.closed?
      end
    end
  end

  it "scalar should close statement" do
    with_dummy do |db|
      db.scalar("1").or_panic
      assert DummyResultSet.last_result_set.closed?
    end
  end

  it "initially a single connection should be created" do
    with_dummy do |db|
      assert connections.size == 1
    end
  end

  it "the connection should be closed after db usage" do
    with_dummy do |db|
      assert !connections.first.closed?
    end
    assert connections.first.closed?
  end

  it "should answer PoolTimeout if the sole connection is been used" do
    with_dummy "dummy://host?max_pool_size=1&checkout_timeout=0.5" do |db|
      db.query("1") do |rs|
        expect_error(db.scalar("2"), PoolTimeout)
        nil
      end.or_panic
    end
  end

  it "should use 'unlimited' connections by default" do
    with_dummy "dummy://host?checkout_timeout=0.5" do |db|
      rs = [] of ResultSet
      500.times do
        rs << db.query("1").or_panic
      end
      assert DummyConnection.connections.size == 500
    end
  end

  it "exec should return to pool" do
    with_dummy do |db|
      db.exec("foo").or_panic
      db.exec("bar").or_panic
    end
  end

  it "scalar should return to pool" do
    with_dummy do |db|
      db.scalar("foo").or_panic
      db.scalar("bar").or_panic
    end
  end

  it "gives nice error message when no driver is registered for schema (#21)" do
    expect_error(::Db.open("foobar://baz"), ArgumentError, %(no driver was registered for the schema "foobar", did you maybe forget to require the database driver?))
  end

  it "should parse boolean query string params" do
    assert fetch_bool(Params.parse("foo=true"), "foo", false).or_panic
    assert fetch_bool(Params.parse("foo=True"), "foo", false).or_panic

    assert !fetch_bool(Params.parse("foo=false"), "foo", true).or_panic
    assert !fetch_bool(Params.parse("foo=False"), "foo", true).or_panic

    assert !fetch_bool(Params.parse("bar=true"), "foo", false).or_panic
    assert fetch_bool(Params.parse("bar=true"), "foo", true).or_panic

    expect_error(fetch_bool(Params.parse("foo=other"), "foo", true), ArgumentError, %(invalid "other" value for option "foo"))
  end
end
