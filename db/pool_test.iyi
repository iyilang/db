# crystal-db's spec/pool_spec.cr.
#
# A factory runs on whichever worker builds a resource now, so it may
# capture only `Share` values: where crystal's examples counted builds in a
# captured integer or kept the resources in a captured array, these count
# in an `Atomic` and keep them in a `Built`.
module db/pool_test

import std/time::{Time, Span}
import std/mutex::{Mutex}
import std/list::{List}
import db/errors::*
import db/core::{Disposable}
import db/pooling::{Pool}
import db/spec::{describe, it, expect_error, panics?}
# crystal's spec_helper loads the dummy driver too; without a Statement
# subclass in the program db/core does not type (see the port report).
import db/testing/dummy_driver::*

class ShouldSleepingOp
  @is_sleeping = false
  getter is_sleeping
  getter sleep_happened : Channel(Nil)

  def initialize
    @sleep_happened = Channel(Nil).new
  end

  # crystal spawned a free fiber here; iyi tasks live in a group, which waits
  # for the sleeper at its end.
  def should_sleep(&)
    s = self
    @is_sleeping = true
    group do |g|
      g.spawn do
        sleep 100
        assert s.is_sleeping
        s.sleep_happened.send(nil)
        0
      end
      yield
      @is_sleeping = false
    end
  end

  def wait_for_sleep
    @sleep_happened.receive
  end
end

class WaitFor
  def initialize
    @channel = Channel(Nil).new
  end

  def wait
    @channel.receive
  end

  def check
    @channel.send(nil)
  end
end

class Closable
  @closed = false
  property before_checkout_called : Bool = false
  property after_release_called : Bool = false

  protected def do_close : Nil | DBError
    nil
  end

  def before_checkout
    @before_checkout_called = true
  end

  def after_release
    @after_release_called = true
  end
end

impl Disposable for Closable
end

# The resources a factory built, oldest first.
class Built
  @made : Mutex(Array(Made(Closable)))

  def initialize
    @made = Mutex.new { [] of Made(Closable) }
  end

  def make : Closable
    resource = Closable.new
    made = Made.new(resource)
    @made.lock { |all| all << made }.or_panic
    resource
  end

  def all : Array(Closable)
    @made.get { |all| List(Made(Closable)).new(all) }.or_panic.map(&.value)
  end
end

# Crystal's `Pool.new` opened the `initial_pool_size` resources itself; iyi's
# `prefill` does it.
@[Share]
def create_pool(options : Pool::Options = Pool::Options.new, &factory : -> Closable) : Pool(Closable)
  pool = Pool(Closable).new(options) { factory.call }
  pool.prefill.or_panic
  pool
end

describe "Db::Pool" do
  it "should use proc to create objects" do
    block_called = Atomic(Int32).new(0)
    pool = create_pool(Pool::Options.new(initial_pool_size: 3)) { block_called.add(1); Closable.new }
    assert block_called.get == 3
  end

  it "should get resource" do
    pool = create_pool { Closable.new }
    resource = pool.checkout.or_panic
    assert resource.is_a?(Closable)
    assert resource.before_checkout_called
  end

  it "should be available if not checkedout" do
    built = Built.new
    pool = create_pool(Pool::Options.new(initial_pool_size: 1)) { built.make }
    r = built.all[0]
    assert pool.is_available?(r)
  end

  it "should not be available if checkedout" do
    pool = create_pool { Closable.new }
    resource = pool.checkout.or_panic
    assert !pool.is_available?(resource)
  end

  it "should be available if returned" do
    pool = create_pool { Closable.new }
    resource = pool.checkout.or_panic
    assert !resource.after_release_called
    pool.release resource
    assert pool.is_available?(resource)
    assert resource.after_release_called
  end

  it "should wait for available resource" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, initial_pool_size: 1)) { Closable.new }

    b_cnn_request = ShouldSleepingOp.new
    wait_a = WaitFor.new
    wait_b = WaitFor.new

    group do |g|
      g.spawn do
        a_cnn = pool.checkout.or_panic
        b_cnn_request.wait_for_sleep
        pool.release a_cnn

        wait_a.check
        0
      end

      g.spawn do
        b_cnn_request.should_sleep do
          pool.checkout.or_panic
        end

        wait_b.check
        0
      end

      wait_a.wait
      wait_b.wait
    end
  end

  it "should create new if max was not reached" do
    block_called = Atomic(Int32).new(0)
    pool = create_pool(Pool::Options.new(max_pool_size: 2, initial_pool_size: 1)) { block_called.add(1); Closable.new }
    assert block_called.get == 1
    pool.checkout.or_panic
    assert block_called.get == 1
    pool.checkout.or_panic
    assert block_called.get == 2
  end

  it "should reuse returned resources" do
    built = Built.new
    pool = create_pool(Pool::Options.new(max_pool_size: 2, initial_pool_size: 1)) { built.make }
    pool.checkout.or_panic
    b1 = pool.checkout.or_panic
    pool.release b1
    b2 = pool.checkout.or_panic

    assert b1 == b2
    assert built.all.size == 2
  end

  # crystal's `close` closed the resources out too, under the task using
  # them; a resource out is closed when it is released.
  it "should close available, and one out when it is released" do
    built = Built.new
    pool = create_pool(Pool::Options.new(max_pool_size: 2, initial_pool_size: 1)) { built.make }
    a = pool.checkout.or_panic
    b = pool.checkout.or_panic
    pool.release b
    all = built.all
    assert all.size == 2

    assert !all[0].closed?
    assert !all[1].closed?
    pool.close
    assert !a.closed?
    assert b.closed?
    pool.release a
    assert a.closed?
    assert pool.stats.open_connections == 0
  end

  it "should timeout" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, checkout_timeout: 0.1)) { Closable.new }
    pool.checkout.or_panic
    expect_error(pool.checkout, PoolTimeout)
  end

  it "should be able to release after a timeout" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, checkout_timeout: 0.1)) { Closable.new }
    a = pool.checkout.or_panic
    pool.checkout # crystal: `rescue nil`; the error value is dropped
    pool.release a
  end

  it "should close if max idle amount is reached" do
    built = Built.new
    pool = create_pool(Pool::Options.new(max_pool_size: 3, max_idle_pool_size: 1)) { built.make }
    pool.checkout.or_panic
    pool.checkout.or_panic
    pool.checkout.or_panic

    all = built.all
    assert all.size == 3
    assert !all.any?(&.closed?)
    pool.release all[0]

    assert !all.any?(&.closed?)
    pool.release all[1]

    assert !all[0].closed?
    assert all[1].closed?
    assert !all[2].closed?
  end

  it "should not return closed resources to the pool" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, max_idle_pool_size: 1)) { Closable.new }

    # pool size 1 should be reusing the one resource
    resource1 = pool.checkout.or_panic
    pool.release resource1
    resource2 = pool.checkout.or_panic
    assert resource1 == resource2

    # it should not return a closed resource to the pool
    resource2.close
    pool.release resource2

    resource2 = pool.checkout.or_panic
    assert resource1 != resource2
  end

  it "should create resource after max_pool was reached if idle forced some close up" do
    built = Built.new
    pool = create_pool(Pool::Options.new(max_pool_size: 3, max_idle_pool_size: 1)) { built.make }
    pool.checkout.or_panic
    pool.checkout.or_panic
    pool.checkout.or_panic
    all = built.all
    pool.release all[0]
    pool.release all[1]
    pool.checkout.or_panic
    pool.checkout.or_panic

    assert built.all.size == 4
  end

  it "counts no resource in flight after the factory panicked" do
    pool = Pool(Closable).new(Pool::Options.new(initial_pool_size: 0, max_pool_size: 1)) { raise "factory failed" }
    assert panics? { pool.checkout; nil }
    assert pool.stats.in_flight_connections == 0
  end

  it "wakes a waiting checkout when a resource leaves the pool" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, checkout_timeout: 1.0)) { Closable.new }
    a = pool.checkout.or_panic
    group do |g|
      g.spawn do
        # a timeout would be a panic: the pool may build a new resource
        assert pool.checkout.or_panic != a
        0
      end
      sleep 50
      a.close
      pool.release a
    end
  end

  # A release hands its resource to the checkout that has waited longest,
  # and a checkout made after the release does not take it first: crystal's
  # pool put it back idle and woke the waiter, which found it gone.
  it "hands a released resource to the waiting checkout" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, checkout_timeout: 1.0)) { Closable.new }
    a = pool.checkout.or_panic
    group do |g|
      g.spawn do
        got = pool.checkout.or_panic
        assert got == a
        sleep 50
        pool.release got
        0
      end
      sleep 100
      pool.release a
      # the waiter has it: this checkout waits until the waiter releases it
      assert pool.checkout.or_panic == a
    end
  end

  it "waits checkout_timeout in all" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, checkout_timeout: 0.3)) { Closable.new }
    pool.checkout.or_panic
    started = Time.monotonic
    expect_error(pool.checkout, PoolTimeout)
    waited = Time.monotonic - started
    assert waited >= Span.milliseconds(290)
    assert waited < Span.milliseconds(600)
  end

  it "takes a checkout_timeout too long for a timer as waiting" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, checkout_timeout: 1e10)) { Closable.new }
    a = pool.checkout.or_panic
    group do |g|
      g.spawn do
        assert pool.checkout.or_panic == a
        0
      end
      sleep 50
      pool.release a
    end
  end

  it "answers a waiting checkout when it is closed" do
    pool = create_pool(Pool::Options.new(max_pool_size: 1, checkout_timeout: 2.0)) { Closable.new }
    pool.checkout.or_panic
    waited = [] of Span
    group do |g|
      g.spawn do
        started = Time.monotonic
        expect_error(pool.checkout, DBError, "the pool is closed")
        waited << Time.monotonic - started
        0
      end
      sleep 50
      pool.close
    end
    assert waited[0] < Span.seconds(1)
  end

  it "builds nothing once it is closed" do
    built = Atomic(Int32).new(0)
    pool = create_pool { built.add(1); Closable.new }
    pool.close
    expect_error(pool.checkout, DBError, "the pool is closed")
    assert built.get == 1
  end
end
