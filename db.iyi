# The entry point: `Db.open`, `Db.connect` and the driver registry,
# crystal-db's `DB` module. iyi-db is the common database interface
# for iyi, ported from crystal-db (https://github.com/crystal-lang/crystal-db);
# a driver for a specific database is needed to access one.
#
# Individual database systems are supported by specific driver modules,
# which register themselves with `register_driver` when they are imported.
#
# A `Database` manages a connection pool. The pool is configured by query
# parameters of the connection URI, as described in `Database`.
#
# ### Usage
#
# ```
# import db
#
# db = Db.open("sqlite3:./path/to/db/file.db")!
# db.close
# ```
#
# With a block the database is closed when the block is left:
#
# ```
# Db.open("sqlite3:./file.db") do |db|
#   # work with db
# end
# ```
#
# `db` is a `Database`; `QueryMethods` describes how to query it. Three kinds
# of statements can be performed:
#
# 1. `Database#exec` expects no rows back.
# 2. `Database#scalar` reads a single value of the response.
# 3. `Database#query` returns a `ResultSet` over the rows and columns.
#
# All of them take query arguments, positionally or as an `args:` array.
# iyi-db does not interpret the statements: SQLite writes `?` where
# PostgreSQL writes `$1`, `$2`, ...
#
# ```
# import db
# import db/db/value::{DBValue}
# import db/db/errors::{DBError}
# import sqlite3/sqlite3 # a driver
#
# def contacts : Nil | DBError
#   Db.open("sqlite3:./file.db") do |db|
#     db.exec("create table contacts (name text, age integer)")!
#     db.exec("insert into contacts values (?, ?)", "John Doe", 30)!
#
#     args = [] of DBValue
#     args << "Sarah"
#     args << 33
#     db.exec("insert into contacts values (?, ?)", args: args)!
#
#     puts "max age:"
#     puts db.scalar("select max(age) from contacts")! # => 33
#
#     puts "contacts:"
#     db.query("select name, age from contacts order by age desc") do |rs|
#       puts "#{rs.column_name(0)} (#{rs.column_name(1)})"
#       # => name (age)
#       rs.each do
#         puts "#{rs.read(String)!} (#{rs.read(Int32)!})"
#         # => Sarah (33)
#         # => John Doe (30)
#       end!
#     end!
#   end!
# end
# ```
#
# ### Object mapping
#
# `derive db_serializable` (module `db/serializable`) maps the rows of a
# result set to a struct or class.
module db

# The types live in `db/core`, `db/errors`, `db/value`, `db/pooling` and
# `db/serializable`; a program imports the ones it names.

import std/uri::{URI, Params}
import db/errors::*
import db/core::*

pub VERSION = "0.2.0"

DRIVERS = {} of String => Driver.class

# The driver class registered for *driver_name*.
pub def driver_class(driver_name : String) : Driver.class | DBError
  DRIVERS[driver_name]? ||
    ArgumentError.new(%(no driver was registered for the schema "#{driver_name}", did you maybe forget to require the database driver?))
end

# Registers a driver class for a given *driver_name*. Called by driver
# implementors, from their module's top level, so importing the driver is
# what registers it.
pub def register_driver(driver_name : String, driver_class : Driver.class) : Nil
  DRIVERS[driver_name] = driver_class
end

# Creates a `Database` pool and opens its initial connection(s) as
# specified in the connection *uri*. Use `connect` to open a single
# connection.
#
# The scheme of the *uri* determines the driver to use. Connection
# parameters such as hostname, user, database name, etc. are specified
# according to each database driver's specific format.
#
# The returned database must be closed by `Database#close`.
pub def open(uri : URI | String) : Database | DBError
  parsed = to_uri(uri)!
  driver = build_driver(parsed)!
  params = Params.parse(parsed.query || "")
  connection_options = driver.connection_options(params)!
  pool_options = driver.pool_options(params)!
  builder = driver.connection_builder(parsed)!
  Database.open(connection_options, pool_options) { builder.build }
end

# Same as `open`, but the database is yielded and closed when the block is
# left.
pub def open(uri : URI | String, & : Database -> U) : U | DBError forall U
  db = open(uri)!
  defer db.close
  yield db
end

# Opens a connection using the specified *uri*. The scheme of the *uri*
# determines the driver to use. The connection must be closed by
# `Connection#close`.
pub def connect(uri : URI | String) : Connection | DBError
  parsed = to_uri(uri)!
  driver = build_driver(parsed)!
  builder = driver.connection_builder(parsed)!
  builder.build
end

# Same as `connect`, but the connection is yielded and closed when the block
# is left. An error closing it is answered, unless the block answered an
# error of its own.
pub def connect(uri : URI | String, & : Connection -> U) : U | DBError forall U
  cnn = connect(uri)!
  finished = false
  defer (cnn.close unless finished)
  value = yield cnn
  finished = true
  closed = cnn.close
  return closed if closed.is_a?(DBError) && !value.is_a?(::Error)
  value
end

def to_uri(uri : URI | String) : URI | DBError
  return uri if uri.is_a?(URI)
  URI.parse?(uri) || ArgumentError.new(%(invalid connection URI "#{uri}"))
end

def build_driver(uri : URI) : Driver | DBError
  klass = driver_class(uri.scheme || "")!
  klass.new
end
